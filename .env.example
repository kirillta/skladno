# Optional for future AI operations. This value is read only by the local service.
# It is deliberately not prefixed with VITE_ and is never available to browser code.
OPENAI_API_KEY=

# The local service listens only on loopback by default.
SKLADNO_SERVER_HOST=127.0.0.1
SKLADNO_SERVER_PORT=8787

# Origin permitted to make development browser requests to the local service.
SKLADNO_WEB_ORIGIN=http://localhost:5173
