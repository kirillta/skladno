{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "area",
        "capabilities",
        "scenarios"
    ],
    "properties": {
        "schemaVersion": {
            "const": 2
        },
        "area": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/capability"
            }
        },
        "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/scenario"
            }
        }
    },
    "$defs": {
        "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$"
        },
        "capability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "area",
                "title",
                "status",
                "owners",
                "contract",
                "persistence"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "area": {
                    "type": "string",
                    "minLength": 1
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "status": {
                    "enum": [
                        "implemented",
                        "partial",
                        "deferred",
                        "retired"
                    ]
                },
                "owners": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "contract": {
                    "type": "string",
                    "minLength": 1
                },
                "persistence": {
                    "type": "string",
                    "minLength": 1
                },
                "stateModelIds": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/id"
                    },
                    "uniqueItems": true
                },
                "relatedCapabilityIds": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/id"
                    },
                    "uniqueItems": true
                },
                "limitations": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "tracking": {
                    "type": "string",
                    "minLength": 1
                },
                "decision": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "scenario": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "title",
                "capabilityIds",
                "preconditions",
                "event",
                "expected",
                "forbidden",
                "evidence"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "capabilityIds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/id"
                    },
                    "uniqueItems": true
                },
                "preconditions": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "event": {
                    "type": "string",
                    "minLength": 1
                },
                "expected": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Required observable outcomes stated directly.",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "forbidden": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Bad outcomes named directly, for example: Rewriting existing Revision records.",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "evidence": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kind",
                        "path"
                    ],
                    "properties": {
                        "kind": {
                            "enum": [
                                "automated",
                                "human-reviewed"
                            ]
                        },
                        "path": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            }
        }
    }
}
